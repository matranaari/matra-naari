# =======================================================
# Matra Naari Production Environment Variables Template
# Copy these keys into your Render Environment Settings
# =======================================================

# Server Port (automatically assigned by hosting provider e.g. Render)
PORT=8000

# Supabase PostgreSQL Session Pooler Connection (Required for Production)
# Format: postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase Storage Configuration (Server-Side Only — Never expose service role key to browser)
SUPABASE_PROJECT_ID=hbpjvtoezlcsyxdxyvna
SUPABASE_URL=https://hbpjvtoezlcsyxdxyvna.supabase.co
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Local / Persistent Fallback Directory for SQLite & Upload Cache
# DATA_DIR=/var/data
# DB_PATH=/var/data/orders.db
# UPLOAD_DIR=/var/data/uploads

# Razorpay Payment Gateway API Keys (Server-Side Secret Verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin Dashboard Security Passkey (Set a strong secret passkey in Render Environment Variables)
ADMIN_SECRET_KEY=

# Store Information (Defaults to Matra Naari branding)
STORE_NAME=Matra Naari
STORE_DESCRIPTION=Modern Kurtis Rooted in Craft
SUPPORT_PHONE=+91 88493 66915
SUPPORT_EMAIL=hello@naari.in
CURRENCY=INR
