# =======================================================
# Naari Production Environment Variables Template
# Copy these keys into your hosting platform's Environment Settings
# =======================================================

# Server Port (automatically assigned by hosting provider e.g. Render/Railway)
PORT=8000

# Optional: Persistent Storage Directory for SQLite Database
# When mounting a persistent disk volume (e.g. Render Disk or Railway Volume):
# DATA_DIR=/var/data
# DB_PATH=/var/data/orders.db

# Razorpay Payment Gateway API Keys (Leave blank to use COD and test simulation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Store Information (Defaults to Naari branding)
STORE_NAME=Naari
STORE_DESCRIPTION=Modern Kurtis Rooted in Craft
SUPPORT_PHONE=+91 88493 66915
SUPPORT_EMAIL=hello@naari.in
CURRENCY=INR
